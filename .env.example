# ==================================================
# PORTAL ARCOP - CONFIGURACIÓN (EJEMPLO)
# ==================================================
# Copia este archivo a .env y completa con tus valores reales

# Apps Script Web App URL (Backend)
REACT_APP_APPS_SCRIPT_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec

# URL del Frontend (donde corre React)
# Desarrollo: http://localhost:3000
# Producción: https://tu-dominio.vercel.app
REACT_APP_FRONTEND_URL=http://localhost:3000

# Información de la empresa
REACT_APP_EMPRESA_NOMBRE=Tu Empresa SpA
REACT_APP_EMPRESA_RUT=12.345.678-9
REACT_APP_DPO_EMAIL=dpo@tuempresa.cl
REACT_APP_DPO_TELEFONO=+56 2 1234 5678